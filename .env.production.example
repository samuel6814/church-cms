APP_NAME="WIS-CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Neon — direct endpoint for migrations; pooled (-pooler) OK for Vercel app traffic
DB_CONNECTION=pgsql
DB_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Optional — Render external cron (see prod_assist/render-external-cron-pattern.md)
CRON_TOKEN=

# Vercel only — set in Dashboard when deploying to Vercel
# VERCEL=1

VITE_APP_NAME="${APP_NAME}"
